{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Public API entries are the sources of the published build outputs and are auto-detected by
  // knip (listing them only triggers "redundant entry" hints): src/index.node.ts (package.json
  // "main"/exports ".": lib/index.node.js), src/index.browser.ts (exports "./browser":
  // lib/index.browser.js), src/cli/index.ts (the "mulmo-slide" bin), and src/vue/main.ts (via
  // the auto-detected vite.config.ts). Only the test scripts need to be listed: every
  // tests/*.ts is a standalone golden-test run by `tsx --test`, so they are entry points, not
  // analyzed source.
  "entry": ["tests/**/*.ts"],
  "project": ["src/**/*.ts"],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false,
  "rules": {
    // Warn mode: every rule is "warn" (reported, exit 0) or "off". Nothing gates CI here.
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "warn",
    "exports": "warn",
    "types": "warn",
    "unresolved": "off",
    "binaries": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off",
  },
}
